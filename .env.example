# ── Service ───────────────────────────────────────────────────────────────
PORT=8080
SERVICE_ROLE=all                 # web | worker | trade | all
DATABASE_URL=postgres://user:pass@localhost:5432/rektbull

# ── Sign in with your wallet ──────────────────────────────────────────────
JWT_SECRET=                      # long random string: openssl rand -hex 32
SIWE_DOMAIN=rektbull.com
SIWE_URI=https://rektbull.com
ADMIN_WALLETS=                   # comma-separated wallet addresses allowed on /admin and /v1/admin/* (docs/ADMIN.md)
OPERATOR_POSTAL_ADDRESS=         # in every newsletter email (CAN-SPAM); no newsletter is sent without it
ANALYZER_URL=                    # optional: the contract analyzer's address (analyzer/, docs/DEPLOY.md); unset, contract audits are refused and not charged
INDEXNOW_KEY=                    # optional: a random 32-character hex string; pings Bing when a digest is published (docs/SEO.md)
NEWSLETTER_PER_TICK=50           # newsletter emails per 5-minute worker tick (Resend free plan: 100 a day)

# ── AI reports ────────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=
REPORT_MODEL=claude-opus-5-5
REPORT_EFFORT=medium             # low | medium | high

# ── Data providers (free plans; see docs/FREE_TIER.md) ────────────────────
ETHERSCAN_API_KEY=               # free at etherscan.io/apis
BLOCKSCOUT_API_KEY=              # free at dev.blockscout.com; used when Etherscan's free plan won't serve a chain
ZEROEX_API_KEY=                  # free at 0x.org; enables the buy-then-sell honeypot test
JUPITER_API_KEY=                 # optional; Solana works on Jupiter's keyless lite API without it
# Your own RPC endpoints per chain, tried before the public one (e.g. Alchemy's free plan). The Wallet
# Tracker's log queries need one for BNB Chain in production (docs/WALLET_TRACKER.md):
RPC_URLS_ETHEREUM=
RPC_URLS_BASE=
RPC_URLS_ARBITRUM=
RPC_URLS_OPTIMISM=
RPC_URLS_POLYGON=
RPC_URLS_BSC=
RPC_URLS_SOLANA=
# Calls per UTC day before a provider is skipped. Set these just under each free plan's limit.
PROVIDER_DAILY_LIMITS={"goplus":5000,"etherscan":90000,"blockscout":90000,"0x":5000,"dexscreener":20000}

# ── NOWPayments (a second checkout: any coin, forwarded to your payout wallet; a fee per payment) ──
NOWPAYMENTS_ENABLED=false
NOWPAYMENTS_API_KEY=
NOWPAYMENTS_IPN_SECRET=
# NOWPAYMENTS_API_BASE=https://api-sandbox.nowpayments.io/v1   # the sandbox, for testing

# ── Trading ───────────────────────────────────────────────────────────────
TRADING_ENABLED=false            # approve-each trading on Base; true to switch on
SWAP_FEE_BPS=100                 # 1%; the Trade Router caps it at 1% onchain
SWAP_FEE_WALLET_EVM=             # where the fee goes, on Base, Ethereum and Arbitrum alike: a hardware wallet, or a Safe deployed at this same address on all three (not in KMS)
SWAP_FEE_WALLET_SOLANA=          # the Solana fee wallet (a public address only; a hardware wallet or a Squads vault). It must hold at least 0.00089 SOL before the first fee, or fees are skipped
# Hyperliquid perps (docs/HYPERLIQUID.md). Users' funds stay in their own Hyperliquid account.
# GEO_COUNTRY_HEADER=X-Client-Geo-Location  # the header the load balancer sets to the client's country (region blocks, docs/ADMIN.md)
HL_ENABLED=false                 # true to open the Perps page for trading (viewing markets works either way)
HL_NETWORK=mainnet               # or testnet (api.hyperliquid-testnet.xyz)
HL_BUILDER_ADDRESS=              # RektBull's builder address: a PUBLIC address only, holding at least 100 USDC on Hyperliquid. Unset: no fee
HL_BUILDER_FEE_TENTHS_BPS=10     # the fee on each fill, in tenths of a basis point: 10 = 0.01% (Hyperliquid's cap on perps is 100 = 0.1%)
# HL_WEIGHT_PER_MINUTE=1000      # RektBull's share of Hyperliquid's 1,200 request weight a minute per IP
# HL_AUTO_MIN_OPEN_INTEREST_USD=5000000   # automatic trading opens positions only in markets at least this deep,
# HL_AUTO_MIN_DAY_VOLUME_USD=5000000      # in open interest and in 24-hour volume
# Claim fee on airdrops and rewards claimed through RektBull (5%, 3% with Safety Pro), in the claimed
# tokens, sent by the user in a transfer next to the claim. Receive-only: a Safe or hardware wallet.
CLAIM_FEE_WALLET_EVM=
# The 0.1% fee on yield moves RektBull prepares (in the moved asset); defaults to the claim fee wallet.
YIELD_FEE_WALLET_EVM=
# Automatic yield rebalancing (docs/YIELD_ROUTER.md): built, off until the Yield Router is audited.
YIELD_AUTO_ENABLED=false
# YIELD_ROUTERS={"8453":"0x..."}  # the deployed Yield Router per chain
# Automatic trading runs on Base Sepolia (built in: src/trade/networks.js) until the router is audited.
# AUTO_TRADING_NETWORKS={...}    # optional: replaces that config (same shape), e.g. for a local fork
SESSION_KEY_ADDRESS=             # the session key's PUBLIC address (its private key is in KMS)
# Trade service only (SERVICE_ROLE=trade): KMS key versions, e.g.
# projects/P/locations/L/keyRings/rektbull/cryptoKeys/session-key/cryptoKeyVersions/1
KMS_SESSION_KEY_VERSION=
DEV_SESSION_KEY=                 # testnets only, refused in production: a throwaway key instead of KMS
RPC_URLS_BASE_SEPOLIA=

# ── Payments: x402 (USDC on Base, per call) ───────────────────────────────
X402_PAY_TO=                     # the address that receives x402 payments (a wallet you control offline)
X402_NETWORK=base                # base-sepolia for testing
X402_ASSET_ADDRESS=              # leave empty for USDC on Base; set Sepolia USDC when testing
CDP_API_KEY_ID=                  # Coinbase Developer Platform key for the x402 facilitator
CDP_API_KEY_SECRET=              # PEM-encoded EC private key from CDP

# ── Payments: USDT/USDC top-ups ───────────────────────────────────────────
CRYPTO_DEPOSIT_XPUB=             # extended PUBLIC key at m/44'/60'/0'/0 (never the xprv)
PAYMENT_CHAINS=ethereum,bsc,base
INVOICE_EXPIRY_MINUTES=60
MIN_TOP_UP_CENTS=500
WATCHER_INTERVAL_MS=20000
WATCHER_MAX_BLOCK_RANGE=500
WATCH_ADDRESS_DAYS=30
