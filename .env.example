# ── Service ───────────────────────────────────────────────────────────────
PORT=8080
SERVICE_ROLE=all                 # web | worker | trade | all
DATABASE_URL=postgres://user:pass@localhost:5432/rektbull

# ── Sign in with your wallet ──────────────────────────────────────────────
JWT_SECRET=                      # long random string: openssl rand -hex 32
SIWE_DOMAIN=rektbull.com
SIWE_URI=https://rektbull.com
ADMIN_WALLETS=                   # comma-separated wallet addresses allowed on /v1/admin/*

# ── AI reports ────────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=
REPORT_MODEL=claude-opus-5-5
REPORT_EFFORT=medium             # low | medium | high

# ── Data providers (free plans; see docs/FREE_TIER.md) ────────────────────
ETHERSCAN_API_KEY=               # free at etherscan.io/apis
BLOCKSCOUT_API_KEY=              # free at dev.blockscout.com; used when Etherscan's free plan won't serve a chain
ZEROEX_API_KEY=                  # free at 0x.org; enables the buy-then-sell honeypot test
JUPITER_API_KEY=                 # optional; Solana works on Jupiter's keyless lite API without it
# Your own RPC endpoints per chain, tried before the public one (e.g. Alchemy's free plan):
RPC_URLS_ETHEREUM=
RPC_URLS_BASE=
RPC_URLS_ARBITRUM=
RPC_URLS_OPTIMISM=
RPC_URLS_POLYGON=
RPC_URLS_BSC=
RPC_URLS_SOLANA=
# Calls per UTC day before a provider is skipped. Set these just under each free plan's limit.
PROVIDER_DAILY_LIMITS={"goplus":5000,"etherscan":90000,"blockscout":90000,"0x":5000,"dexscreener":20000}

# ── Trading ───────────────────────────────────────────────────────────────
TRADING_ENABLED=false            # approve-each trading on Base; true to switch on
SWAP_FEE_BPS=100                 # 1%; the Trade Router caps it at 1% onchain
SWAP_FEE_WALLET_EVM=             # where the fee goes: a Safe or hardware wallet you control (not in KMS)
TRADE_ROUTERS={"84532":"0x9307067d6a5FC22d1085A2Fb16B1385DCC0E6B68"}   # Base Sepolia only until the audit
SESSION_KEY_ADDRESS=             # the session key's PUBLIC address (its private key is in KMS)
# Trade service only (SERVICE_ROLE=trade): KMS key versions, e.g.
# projects/P/locations/L/keyRings/rektbull/cryptoKeys/session-key/cryptoKeyVersions/1
KMS_SESSION_KEY_VERSION=
KMS_GAS_KEY_VERSION=
RPC_URLS_BASE_SEPOLIA=

# ── Payments: x402 (USDC on Base, per call) ───────────────────────────────
X402_PAY_TO=                     # the address that receives x402 payments (a wallet you control offline)
X402_NETWORK=base                # base-sepolia for testing
X402_ASSET_ADDRESS=              # leave empty for USDC on Base; set Sepolia USDC when testing
CDP_API_KEY_ID=                  # Coinbase Developer Platform key for the x402 facilitator
CDP_API_KEY_SECRET=              # PEM-encoded EC private key from CDP

# ── Payments: USDT/USDC top-ups ───────────────────────────────────────────
CRYPTO_DEPOSIT_XPUB=             # extended PUBLIC key at m/44'/60'/0'/0 (never the xprv)
PAYMENT_CHAINS=ethereum,bsc,base
INVOICE_EXPIRY_MINUTES=60
MIN_TOP_UP_CENTS=500
WATCHER_INTERVAL_MS=20000
WATCHER_MAX_BLOCK_RANGE=500
WATCH_ADDRESS_DAYS=30
