{
  "name": "@rektbull/presign-check",
  "version": "0.1.0",
  "description": "RektBull's pre-sign check inside MetaMask: what a transaction or signature would do, simulated and checked, before you confirm it.",
  "repository": {
    "type": "git",
    "url": "https://github.com/SoyjakAgentic/RektBull.git"
  },
  "license": "MIT",
  "main": "./dist/bundle.js",
  "files": [
    "dist/",
    "images/",
    "snap.manifest.json"
  ],
  "scripts": {
    "build": "mm-snap build",
    "serve": "mm-snap serve",
    "test": "SNAP_ENV=test mm-snap build && jest; status=$?; mm-snap build >/dev/null; exit $status"
  },
  "dependencies": {
    "@metamask/snaps-sdk": "12.1.0"
  },
  "devDependencies": {
    "@metamask/snaps-cli": "8.4.1",
    "@metamask/snaps-jest": "10.2.2",
    "jest": "^29.7.0",
    "@babel/core": "^7.26.0",
    "@babel/preset-env": "^7.26.0",
    "babel-jest": "^29.7.0"
  },
  "engines": {
    "node": ">=22.13"
  },
  "overrides": {
    "uuid": "^11.1.1",
    "bn.js": "^5.2.3"
  },
  "jest": {
    "preset": "@metamask/snaps-jest",
    "testMatch": [
      "<rootDir>/test/**/*.test.js"
    ],
    "testTimeout": 30000,
    "transform": {
      "^.+\\.[cm]?js$": [
        "babel-jest",
        {
          "presets": [
            [
              "@babel/preset-env",
              {
                "targets": {
                  "node": "current"
                }
              }
            ]
          ],
          "babelrc": false,
          "configFile": false
        }
      ]
    },
    "transformIgnorePatterns": [
      "/node_modules/(?!(@metamask|@noble|@scure|superstruct|uuid)/)"
    ]
  }
}
