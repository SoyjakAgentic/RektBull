{
  "name": "rektbull-contracts",
  "private": true,
  "description": "RektBull Trade Router and its break-it tests",
  "scripts": {
    "build": "hardhat compile",
    "test": "hardhat test",
    "deploy:base-sepolia": "hardhat run scripts/deploy.js --network baseSepolia",
    "deploy:base:rehearse": "hardhat run scripts/deployRouter.js --network baseMainnetFork",
    "deploy:base": "hardhat run scripts/deployRouter.js --network base",
    "verify:base": "hardhat run scripts/verifyRouter.js --network baseRead",
    "deploy:ethereum:rehearse": "hardhat run scripts/deployRouter.js --network ethereumMainnetFork",
    "deploy:ethereum": "hardhat run scripts/deployRouter.js --network ethereum",
    "verify:ethereum": "hardhat run scripts/verifyRouter.js --network ethereumRead",
    "deploy:arbitrum:rehearse": "hardhat run scripts/deployRouter.js --network arbitrumMainnetFork",
    "deploy:arbitrum": "hardhat run scripts/deployRouter.js --network arbitrum",
    "verify:arbitrum": "hardhat run scripts/verifyRouter.js --network arbitrumRead",
    "export:signin-check": "hardhat compile && node scripts/exportSignInCheck.js"
  },
  "devDependencies": {
    "@metamask/delegation-abis": "^2.0.0",
    "@metamask/delegation-core": "^3.0.0",
    "@metamask/delegation-deployments": "^2.1.0",
    "@nomicfoundation/hardhat-ethers": "^4.2.2",
    "@nomicfoundation/hardhat-node-test-runner": "^3.1.2",
    "@openzeppelin/contracts": "^5.6.1",
    "ethers": "^6.17.0",
    "hardhat": "^3.21.2"
  },
  "type": "module",
  "engines": {
    "node": ">=22.13"
  },
  "overrides": {
    "uuid": "^11.1.1"
  }
}
