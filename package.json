{
  "name": "rektbull",
  "version": "0.1.0",
  "private": true,
  "description": "RektBull: crypto discovery, safety checks and paid agent runs. Crypto payments only.",
  "main": "src/server.js",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "start": "node src/server.js",
    "start:web": "SERVICE_ROLE=web node src/server.js",
    "start:worker": "SERVICE_ROLE=worker node src/server.js",
    "dev": "node --watch src/server.js",
    "db:migrate": "node src/config/migrate.js",
    "test": "node --test --test-concurrency=1 test/*.test.js",
    "extension:zip": "cd extension && rm -f ../rektbull-extension.zip && zip -qr ../rektbull-extension.zip . -x README.md"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.133.0",
    "@fontsource-variable/bricolage-grotesque": "^5.3.0",
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@fontsource/ibm-plex-sans": "^5.3.0",
    "@google-cloud/kms": "^6.3.0",
    "@metamask/delegation-abis": "^2.0.0",
    "@metamask/delegation-core": "^3.0.0",
    "@metamask/delegation-deployments": "^2.1.0",
    "axios": "^1.7.2",
    "ethers": "^6.13.1",
    "express": "^4.19.2",
    "express-async-errors": "^3.1.1",
    "express-rate-limit": "^7.3.1",
    "helmet": "^7.1.0",
    "jsonwebtoken": "^9.0.2",
    "pg": "^8.12.0",
    "web-push": "^3.6.7"
  },
  "overrides": {
    "uuid": "^11.1.1"
  }
}
